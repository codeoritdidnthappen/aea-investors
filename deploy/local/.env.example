# Copy to .env (in this directory) and fill in. .env is never committed — see the
# repository .gitignore. Every value here is a placeholder only.
#
# `docker compose` automatically loads a `.env` file from this directory, so run
# `docker compose` commands from here (or pass `--env-file deploy/local/.env`).

# --- MariaDB ----------------------------------------------------------------
MARIADB_ROOT_PASSWORD=
OPENEMR_MYSQL_USER=openemr
OPENEMR_MYSQL_PASSWORD=

# --- OpenEMR ------------------------------------------------------------------
OPENEMR_ADMIN_USER=admin
OPENEMR_ADMIN_PASSWORD=
OPENEMR_HTTP_PORT=8080
OPENEMR_HTTPS_PORT=8443

# --- OpenEMR: portal chat module (TICK-012) ------------------------------------
# The only src the aeai-portal-chat module's iframe ever loads. Defaults to the
# local chat hostname; an OCI/other deployment overrides it with that
# environment's own chat hostname (ARCHITECTURE.md §9).
AEAI_PORTAL_CHAT_URL=https://chat.localhost/oauth/launch
# The AI server's logout endpoint, beaconed by the module when the patient signs out
# of the portal so the AI session ends with the portal session (TICK-055). Must be on
# the same origin as AI_SESSION_PORTAL_ORIGIN's counterpart below allows.
AEAI_PORTAL_CHAT_LOGOUT_URL=https://chat.localhost/api/logout

# --- Caddy: local ingress (TICK-023) ------------------------------------------
# Local-only reverse proxy; see README.md and Caddyfile. No public/cloud exposure.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- AI server: session store -------------------------------------------------
# 32 random bytes, base64url-encoded. Generate with:
#   python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
AI_SESSION_ENCRYPTION_KEY=
# --- AI server: destination and chat origin (TICK-051) ------------------------
# These two replaced the single AI_SESSION_SUCCESS_REDIRECT_URI and are **not**
# interchangeable, however similar they look. Do not collapse them back into one
# value, and do not derive either from the other -- see ADR-8.
#
# Where the patient lands once an authorization completes at *top level*: the portal
# dashboard, never the standalone chat page (FR-2, FR-31). An authorization that
# completes inside the portal's chat panel loads the chat in that panel instead; the
# AI server tells the two apart from the browser's own `Sec-Fetch-Dest` header, and no
# `next=`/`redirect=` parameter is involved or may be added.
AI_SESSION_DASHBOARD_REDIRECT_URI=https://emr.localhost/portal/home.php
# The origin the AI server's own chat page (TICK-013) is served from, and therefore
# the only Origin POST /api/chat will accept. This is the only CSRF defense on that
# route: the AI session cookie is deliberately SameSite=None so it survives the
# cross-site portal iframe, which means the cookie alone proves nothing about who sent
# the request. Setting this to the portal's origin would 403 the chat page's own
# fetch() on every turn.
AI_SESSION_CHAT_ORIGIN=https://chat.localhost
# The portal origin permitted to end an AI session at /api/logout (TICK-055). The
# portal's own session cookie is SameSite=Strict, so sign-out must stay a same-site
# navigation to portal/logout.php and the AI session has to be ended by a call the
# portal page makes itself -- which carries this origin. /api/chat never accepts it.
# Leave blank to keep logout chat-origin-only (portal sign-out then cannot reach it).
AI_SESSION_PORTAL_ORIGIN=https://emr.localhost

# --- AI server: OpenEMR OAuth client ------------------------------------------
# Register a confidential OAuth client against the running local OpenEMR instance
# (Admin > System > API Clients, or POST /oauth2/default/registration) and copy its
# values here. See README.md for the exact local registration steps.
#
# AUTHORIZE_URL and ISSUER are browser-facing (the patient's browser is redirected
# there, and ISSUER must match the `iss` claim OpenEMR puts in its ID tokens, which
# follows OpenEMR's own configured site address) and now go through Caddy's
# `emr.localhost` hostname (TICK-023), which the AI-server container can also
# resolve, unlike the previously host-only `localhost:8443`. TOKEN_URL and
# JWKS_URL are called server-to-server by the AI server directly over the
# ai-server<->openemr Docker network. REDIRECT_URI goes through Caddy's
# `chat.localhost` hostname since the AI server's port is no longer published to
# the host directly (docker-compose.yml).
OPENEMR_OAUTH_AUTHORIZE_URL=https://emr.localhost/oauth2/default/authorize
OPENEMR_OAUTH_TOKEN_URL=https://openemr/oauth2/default/token
OPENEMR_OAUTH_JWKS_URL=https://openemr/oauth2/default/jwk
OPENEMR_OAUTH_ISSUER=https://emr.localhost/oauth2/default
OPENEMR_OAUTH_CLIENT_ID=
OPENEMR_OAUTH_CLIENT_SECRET=
OPENEMR_OAUTH_REDIRECT_URI=https://chat.localhost/oauth/callback

# --- AI server: LLM -------------------------------------------------------
# Groq free tier — no paid plan required for the default demo path (NFR-20).
# Leave GROQ_API_KEY blank until the chat/LLM endpoints that use it are wired in;
# the AI server starts and serves /health without it.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_ZDR_VERIFIED_ON=

# --- AI server: local model server (TICK-059) ---------------------------------
# The `ollama` service in docker-compose.yml runs a pinned local model (Ollama in
# development per LOCAL_LLM_SPEC D5/D7; vLLM when this is deployed, TICK-067). It
# starts with the rest of the stack and pulls its model once, on first start, into
# the `ollama-models` named volume -- there is no manual pull step.
#
# Every value below is already defaulted in docker-compose.yml, because the pin has
# to live in a committed file rather than in this gitignored one. Set them here only
# to override. Uncommented copies are shown so the shipped pin is visible.
#
# Set LLM_PROVIDER=ollama above to actually route turns through it; left at `groq`
# the model server still runs and stays ready, it is simply not asked anything.
#
# The model is pinned by name *and* by digest. The digest is the sha256 of the
# Ollama registry manifest -- what `/api/tags` reports and what `ollama list` shows
# truncated to 12 characters in its ID column. The model server verifies it on
# every start and refuses to serve on a mismatch, so a moved upstream tag is a loud
# failure rather than silently different weights answering questions about a chart.
# Change the two together; `deploy/local/verify-stack.sh` checks them once running.
#
# ~7B Q4_K_M instruct model per LOCAL_LLM_SPEC D11, provisional until TICK-062's
# benchmark picks the final one.
#LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
#LLM_MODEL_DIGEST=sha256:845dbda0ea48ed749caafd9e6037047aa19acfcfd82e704d7ca97d631a0b697e
# How the AI server reaches it: a Docker service name on the shared `app` network,
# never a host address. The client's built-in fallback (http://localhost:11434)
# resolves to the AI server's own container and works on no machine but a developer
# laptop running Ollama natively.
#OLLAMA_HOST=http://ollama:11434
# Optional: Ollama needs no key; other OpenAI-compatible servers do.
LLM_API_KEY=

# --- AI server: real appointment booking (TICK-034) and cancellation (TICK-036) ---
# Optional, same as GROQ_API_KEY above: leave blank and the chat tool falls back to
# its fixed no-action summary instead of failing startup. Set all of these together
# to enable real booking and cancellation through OpenEMR's FHIR/Portal APIs.
OPENEMR_FHIR_BASE_URL=https://emr.localhost/apis/default/fhir
OPENEMR_PORTAL_BASE_URL=https://emr.localhost/apis/default
# This office's admin-configured appointment fields (ai_server/app/chat.py,
# BookingToolSettings) -- OpenEMR's booking endpoint has no default for any of
# these (ai_server/scheduling/booking.py, AppointmentRequest). Look up real ids in
# OpenEMR's Administration > Practice Setup screens for the local synthetic office.
AI_BOOKING_CATEGORY_ID=
AI_BOOKING_TITLE=
AI_BOOKING_FACILITY_ID=
AI_BOOKING_BILLING_LOCATION_ID=
# Optional: a specific provider id. Left blank, OpenEMR assigns no provider.
AI_BOOKING_PROVIDER_ID=
