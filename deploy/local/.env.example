# Copy to .env (in this directory) and fill in. .env is never committed — see the
# repository .gitignore. Every value here is a placeholder only.
#
# `docker compose` automatically loads a `.env` file from this directory, so run
# `docker compose` commands from here (or pass `--env-file deploy/local/.env`).

# --- MariaDB ----------------------------------------------------------------
MARIADB_ROOT_PASSWORD=
OPENEMR_MYSQL_USER=openemr
OPENEMR_MYSQL_PASSWORD=

# --- OpenEMR ------------------------------------------------------------------
OPENEMR_ADMIN_USER=admin
OPENEMR_ADMIN_PASSWORD=
OPENEMR_HTTP_PORT=8080
OPENEMR_HTTPS_PORT=8443

# --- AI server: session store -------------------------------------------------
# 32 random bytes, base64url-encoded. Generate with:
#   python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
AI_SESSION_ENCRYPTION_KEY=
AI_SESSION_SUCCESS_REDIRECT_URI=https://localhost:8443/portal/home.php

# --- AI server: OpenEMR OAuth client ------------------------------------------
# Register a confidential OAuth client against the running local OpenEMR instance
# (Admin > System > API Clients, or POST /oauth2/default/registration) and copy its
# values here. See README.md for the exact local registration steps.
#
# AUTHORIZE_URL and ISSUER are browser-facing (the patient's browser is redirected
# there, and ISSUER must match the `iss` claim OpenEMR puts in its ID tokens, which
# follows OpenEMR's own configured site address). TOKEN_URL and JWKS_URL are called
# server-to-server by the AI server, so they use the ai-server<->openemr Docker
# network instead of the host-published port.
OPENEMR_OAUTH_AUTHORIZE_URL=https://localhost:8443/oauth2/default/authorize
OPENEMR_OAUTH_TOKEN_URL=https://openemr/oauth2/default/token
OPENEMR_OAUTH_JWKS_URL=https://openemr/oauth2/default/jwk
OPENEMR_OAUTH_ISSUER=https://localhost:8443/oauth2/default
OPENEMR_OAUTH_CLIENT_ID=
OPENEMR_OAUTH_CLIENT_SECRET=
OPENEMR_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback

# --- AI server: LLM -------------------------------------------------------
# Groq free tier — no paid plan required for the default demo path (NFR-20).
# Leave GROQ_API_KEY blank until the chat/LLM endpoints that use it are wired in;
# the AI server starts and serves /health without it.
AI_SERVER_PORT=8000
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_ZDR_VERIFIED_ON=
