# Project
requirements/

# dotenv environment variable files
.env
.env.*
!.env.example

# OS
.DS_Store
.builder/
__pycache__/
*.pyc
.pytest_cache/
node_modules/

# Content-addressed cache: pipeline/data/raw/ is never committed (ARCHITECTURE.md §4.2).
# pipeline/data/interim/, pipeline/data/out/ and pipeline/labels/ ARE committed artifacts.
# The dir itself is kept so a clean clone still has the layout; only its contents are ignored.
pipeline/data/raw/*
!pipeline/data/raw/.gitkeep

# The DuckDB database file is local engine state, regenerated by `connect()` on demand.
# The GeoParquet tables beside it are the artifacts; this is not one.
pipeline/data/interim/*.duckdb
pipeline/data/interim/*.duckdb.wal

# Python tooling
.venv/
.ruff_cache/

# TypeScript / Node build output
dist/
*.tsbuildinfo
coverage/
