# Copy to .env and fill in. .env is never committed.
# Placeholders only in this file — no real values, ever.
# Every variable here must also be set in the deployment host's environment.

# --- Git ------------------------------------------------------------------
GIT_USER_NAME=                    # git committer name, used by `make git-setup`
GIT_USER_EMAIL=                   # git committer email, used by `make git-setup`

# --- LLM ------------------------------------------------------------------
# Pick one provider. Free tier or local — no paid API required.
LLM_PROVIDER=ollama               # groq | gemini | ollama
LLM_MODEL=                        # e.g. llama-3.3-70b-versatile, gemini-2.0-flash, llama3.2
LLM_TIMEOUT_MS=8000               # hard ceiling; on timeout the chat falls back to a form
GROQ_API_KEY=                     # console.groq.com — free, no card
GEMINI_API_KEY=                   # aistudio.google.com/apikey — free tier
OLLAMA_HOST=http://localhost:11434

# --- OCR ------------------------------------------------------------------
# Runs locally. ID images never leave our infrastructure.
OCR_ENGINE=tesseract              # tesseract | paddle
OCR_CONFIDENCE_FLOOR=0.70         # below this a field is reported absent, never guessed
OCR_TIMEOUT_MS=8000               # on timeout the flow falls back to manual entry

# --- Database + auth ------------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/intake_development
SUPABASE_URL=
SUPABASE_ANON_KEY=                # browser-side, public by design
SUPABASE_SERVICE_ROLE_KEY=        # server-side only — never expose to the frontend

# --- Document storage -----------------------------------------------------
STORAGE_BUCKET=intake-documents   # private bucket, signed URLs only
DOCUMENT_RETENTION_SECONDS=3600   # ceiling on how long a source ID image may exist
UPLOAD_MAX_BYTES=10485760         # 10 MB; rejected server-side above this

# --- App ------------------------------------------------------------------
RAILS_ENV=development
SECRET_KEY_BASE=                  # `rails secret`
API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
