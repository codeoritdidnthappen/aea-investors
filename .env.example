# Copy to .env and fill in. .env is never committed.
# Placeholders only in this file — no real values, ever.
# Every variable here must also be set in the deployment host's environment.

# --- Git ------------------------------------------------------------------
GIT_USER_NAME=                    # git committer name, used by `make git-setup`
GIT_USER_EMAIL=                   # git committer email, used by `make git-setup`

# --- LLM ------------------------------------------------------------------
# Pick one provider. Free tier or local — no paid API required.
LLM_PROVIDER=groq                 # groq | ollama — an unlisted value fails at startup
LLM_MODEL=                        # required for ollama; e.g. llama3.2 (groq's is pinned)
LLM_TIMEOUT_MS=8000               # hard ceiling; on timeout the chat falls back to a form
GROQ_API_KEY=                     # console.groq.com — free, no card
GEMINI_API_KEY=                   # aistudio.google.com/apikey — free tier (no client yet)
OLLAMA_HOST=http://localhost:11434
LLM_API_KEY=                      # optional bearer token for OLLAMA_HOST; ollama needs none
