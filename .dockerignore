# Keeps the ai-server build context small and reproducible; mirrors .gitignore.
.git
.venv
.builder
__pycache__
*.pyc
.pytest_cache
.ruff_cache
node_modules
dist
*.tsbuildinfo
coverage
.coverage
generated-fixtures
# TICK-062: the acceptance corpus and its recorded runs are evaluation-only data.
# ai-server.Dockerfile copies `ai_server` and nothing else, so they were never going
# to ship; this keeps them out of the build context too, and states the rule where
# someone widening that COPY would read it.
eval
deploy/local/.env
